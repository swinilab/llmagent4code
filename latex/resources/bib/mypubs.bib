	keywords = {DSL, Java, Object oriented modeling, Software, Unified modeling language, Generators, Software engineering},
	pages = {77--82},
	file = {Le et al. - 2017 - Generative Software Module Development A Domain-D.pdf:/data/docs/refman/storage/4L8287YR/Le et al. - 2017 - Generative Software Module Development A Domain-D.pdf:application/pdf},
}

