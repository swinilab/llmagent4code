	pages = {19--24},
	file = {Le - 2015 - A Tree-Based, Domain-Oriented Software Architectur.pdf:/data/docs/refman/storage/R2AHTV7V/Le - 2015 - A Tree-Based, Domain-Oriented Software Architectur.pdf:application/pdf},
