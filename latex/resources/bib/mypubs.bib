@article{le_automating_2023,
	title = {Automating {Domain} {Driven} {Design} with {Transformation}-{Based} {Pattern} {Application} in {Object} {Oriented} {Programming} {Languages}},
	volume = {(Preprint submitted)},
	opturl = {https://www.researchgate.net/publication/376648305_Automating_Domain_Driven_Design_with_Transformation-Based_Pattern_Application_in_Object_Oriented_Programming_Languages},
	abstract = {Domain driven design (DDD) consists in a system of high-level design patterns for domain model construction. Recent work have proposed to realise these patterns in object oriented programming languages (OOPLs), using annotation-based domain specific language (aDSL). Constructing complex domain models require reusing more than a few patterns, which are repeatedly applied to different parts of a model. This calls for an approach to automate the application of these patterns. However, there has been no work that tackles this problem in the DDD context. In this work, we propose a method to bridge this gap. We treat pattern application as a model merging transformation and propose to use an aDSL, named DCSL, and OOPL-friendly abstractions to define this transformation. We revisit an important DDD pattern, named Aggregates, and propose a pattern model for it. We use DCSL to specify both the domain and pattern models. We establish pattern mapping, express it using JSON and formally define the generic primitive transformation operators. We use these to define two algorithms to construct generic transformation procedures and program. We demonstrate our method with an implementation in a DDD software framework and evaluate it using the essential DDD patterns and a well-known DDD's software case study. We evaluate the extent to which our method helps automate pattern application. The results show that (i) our method is effective for constructing software using a combination of domain patterns and (ii) transformation-based automation helps save significant construction effort over time.},
	journal = {Software Practice and Experience},
	author = {Le, Duc Minh},
	month = nov,
	year = {2023},
	file = {Le - 2023 - Automating Domain Driven Design with Transformatio.pdf:/data/docs/refman/storage/9T3HQULV/Le - 2023 - Automating Domain Driven Design with Transformatio.pdf:application/pdf},
}



@inproceedings{le_managing_2022,
	address = {Japan (Virtual)},
	title = {Managing {Complexity} in {Microservices} {Architecture}: {A} {Nested} {MultiTree} {Domain}-{Driven} {Approach}},
	url = {https://www.researchgate.net/publication/364326886_Managing_Complexity_in_Microservices_Architecture_A_Nested_MultiTree_Domain-Driven_Approach},
	abstract = {Domain-driven design (DDD) is commonly used with
microservices architecture (MSA) to develop scalable, businessdriven service-based software. Layered, tree-based architectures
have recently been mentioned for MSA to tame the system
complexity. However, there exists a knowledge gap in terms of the
exact nature of this architecture style and how it is constructed.
In this paper, we propose a nested, multitree microservices architecture (named TMSA) to fill this gap. We define TMSA based on
a module-based RESTful DDD software architecture. A service
is composed of a nested service tree. Service structure reuse is
inherently supported by the multitree. The multitree structure
also provides a scaffolding on which to define two types of service
resiliency and two architecture reconfiguration operations. To
construct TMSA directly in OOPLs, we propose an annotationbased specification language, named TASL. We modularly define
TASL based on an existing specification language. We implement
TMSA as part of a DDD software framework, named JDA},
	language = {en},
	booktitle = {Proc. {Conf}. {APSEC} 2022},
	publisher = {IEEE Computer Society},
	author = {Le, Duc Minh},
	year = {2022},
}


@inproceedings{le_generating_2022,
	address = {Hanoi, Vietnam},
	title = {Generating {Multi}-platform {Single} {Page} {Applications}: {A} {Hierarchical} {Domain}-{Driven} {Design} {Approach}},
	abstract = {Single Page Application (SPA) is a most common approach for
developing modern web applications. A chief benefit of SPA is
reduced round-trip to the server and more responsive user experience. Although several well-known SPA frameworks have been
developed and applied in practice, SPA developers are still facing
two main challenges: (1) design an SPA that would work across
the frameworks and (2) realise this design in an intermediate high-level language that would effectively be transformed into a target
framework of choice. In this paper, we propose a multi-platform, hirerarchical domain-driven design method to tackle these challenges.
Our method uses the domain model as the core to build the SPA. We
formulate a set of essential technical SPA requirement patterns and,
based on these, define a precise SPA metamodel in UML/OCL. We
use an annotation-based DSL as an intermediate representational
language for the SPA metamodel and from this propose an SPA
generator that generates SPAs for four popular SPA frameworks
(Angular, React (Native) and Vuejs). The evaluation results show
that our method is very promising for building multi-platform SPAs},
	language = {en},
	booktitle = {Proc. {Conf}. 11th {SOICT} 2022},
	publisher = {ACM},
	author = {Le, Duc Minh and Nguyen, Anh Phuong and Tran, Linh Quang and Le, Hong Thi and Tong, Hai Van-Anh},
	year = {2022},
}

@inproceedings{le_towards_2022,
	address = {Hanoi, Vietnam},
	title = {Towards {Generating} {RESTful} {Full} {Stack} {Software}: {A} {Module} {Based} {Domain} {Driven} {Design} {Approach}},
	abstract = {Domain-driven design (DDD) has widely been used to de-
velop RESTful software in a range of programming language platforms.
The use of code generators in these technologies helps significantly in-
crease productivity and achieve large scale software reuse. However, there
been no work that address incremental construction of RESTful full stack
software (RFS) at both the module and software levels. In this paper, we
propose a generative module-based method for RFS to bridge this gap.
We characterise RFS and realise this in a module-based DDD software
architecture, named MOSAR. Our method takes as input a software con-
figuration and the required software assets and automatically generates
a module-based RFS software. We present algorithms for the frontend
and backend generation functions. The backend software consist of web
service modules. The frontend software consists of modules that are de-
signed with single-page views. Each view can be nested to reflect the
containment tree of the module. We demonstrate by implementing the
generators for two popular platforms (React and Spring Boot). The eval-
uation shows that the generators are able to support large software.},
	language = {en},
	booktitle = {2nd {Conf}. {ICISN} 2022},
	publisher = {Springer LNCS},
	author = {Le, Duc Minh and Vu, Ha Thanh},
	year = {2022},
}



