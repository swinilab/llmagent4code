POSTGRES_DB=oms
POSTGRES_USER=oms
POSTGRES_PASSWORD=replace-with-a-long-random-password
OMS_DATABASE_URL=postgresql+asyncpg://oms:replace-with-a-long-random-password@postgres:5432/oms
OMS_REDIS_URL=redis://redis:6379/0
OMS_EVENT_MAX_RATE=25
OMS_EVENT_BATCH_SIZE=50
OMS_EVENT_POLL_INTERVAL_SECONDS=0.25
OMS_CACHE_TTL_SECONDS=300
OMS_STATE_SYNC_INTERVAL_SECONDS=60
OMS_DEPENDENCY_TIMEOUT_SECONDS=1.5
OMS_LOG_LEVEL=INFO
