{
  "app": {
    "name": "OMS Backend",
    "version": "1.0.0",
    "debug": false,
    "host": "0.0.0.0",
    "port": 8000
  },
  "database": {
    "url": "sqlite:///./oms.db",
    "echo": false,
    "pool_pre_ping": true,
    "connect_args": {
      "check_same_thread": false
    }
  },
  "resilience": {
    "circuit_breaker": {
      "failure_threshold": 5,
      "recovery_timeout": 60,
      "half_open_max_calls": 3
    },
    "retry": {
      "max_attempts": 3,
      "backoff_factor": 0.5
    },
    "state_snapshot_interval": 30
  },
  "features": {
    "analytics_enabled": true,
    "notifications_enabled": true,
    "audit_log_enabled": true
  }
}
