# ── Application ──────────────────────────────────────────────
OMS_APP_NAME=OMS Backend
OMS_APP_VERSION=1.0.0
OMS_DEBUG=false
OMS_HOST=0.0.0.0
OMS_PORT=8000

# ── Database ─────────────────────────────────────────────────
# SQLite path (relative or absolute). WAL mode is enabled automatically.
OMS_DATABASE_URL=sqlite+aiosqlite:///./oms.db
OMS_DB_ECHO=false
OMS_DB_POOL_SIZE=10
OMS_DB_MAX_OVERFLOW=20

# ── Queue / Backpressure ─────────────────────────────────────
OMS_QUEUE_MAX_SIZE=500
OMS_QUEUE_WORKER_COUNT=4
OMS_QUEUE_TIMEOUT_SECONDS=5.0

# ── Circuit Breaker ──────────────────────────────────────────
OMS_CB_FAILURE_THRESHOLD=5
OMS_CB_RECOVERY_TIMEOUT=30.0
OMS_CB_HALF_OPEN_MAX_CALLS=3

# ── Graceful Degradation ─────────────────────────────────────
# CPU/memory percentage at which non-essential endpoints are degraded.
OMS_DEGRADATION_CPU_THRESHOLD=85.0
OMS_DEGRADATION_MEMORY_THRESHOLD=85.0
OMS_DEGRADATION_CHECK_INTERVAL=10.0

# ── Tax ──────────────────────────────────────────────────────
OMS_DEFAULT_TAX_RATE=0.20
OMS_DEFAULT_CURRENCY=USD