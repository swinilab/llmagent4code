  "components": {
    "schemas": {
      "BankingDetails": {
        "properties": {
          "accountNumber": {
            "type": "string",
            "maxLength": 20,
            "minLength": 6,
            "pattern": "^\\d{6,20}$",
            "title": "Accountnumber"
          },
          "bankName": {
            "type": "string",
            "maxLength": 100,
            "minLength": 2,
            "title": "Bankname"
          }
        },
