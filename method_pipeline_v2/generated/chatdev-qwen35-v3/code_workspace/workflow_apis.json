{
  "acceptOrder": {
    "method": "POST",
    "pathTemplate": "/api/v1/orders/{id}/accept",
    "precondition": "PLACED"
  },
  "createInvoice": {
    "method": "POST",
    "pathTemplate": "/api/v1/orders/{id}/invoice",
    "precondition": "ACCEPTED"
  },
  "payInvoice": {
    "method": "POST",
    "pathTemplate": "/api/v1/payments",
    "precondition": "INVOICED"
  },
  "verifyPayment": {
    "method": "POST",
    "pathTemplate": "/api/v1/payments/{id}/verify",
    "precondition": "PENDING"
  },
  "verifyOrder": {
    "method": "POST",
    "pathTemplate": "/api/v1/orders/{id}/verify",
    "precondition": "PAID"
  },
  "shipOrder": {
    "method": "POST",
    "pathTemplate": "/api/v1/orders/{id}/ship",
    "precondition": "VERIFIED"
  },
  "closeOrder": {
    "method": "POST",
    "pathTemplate": "/api/v1/orders/{id}/close",
    "precondition": "SHIPPED"
  }
}
