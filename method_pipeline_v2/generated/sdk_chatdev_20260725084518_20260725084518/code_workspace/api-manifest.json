{
  "baseUrl": "http://localhost:8000/api/v1",

  "queue": {
    "healthEndpoint": { "method": "GET", "path": "/health/queue" },
    "drainField": "queue_size",
    "drainedWhen": 0,
    "pollIntervalMs": 100,
    "timeoutMs": 5000
  },

  "entities": {
    "Customer": {
      "basePath": "customers",

      "responseEnvelope": { "style": "flat", "dataPath": "" },
      "listEnvelope": { "dataPath": "" },
      "errorResponseSchema": {
        "statusField": "detail",
        "messageField": "detail",
        "fieldErrorsPath": null
      },

      "fieldMap": {
        "id": "id",
        "name": "name",
        "address": "address",
        "phone": "phone",
        "bankingDetails.accountNumber": "bankingDetails.accountNumber",
        "bankingDetails.bankName": "bankingDetails.bankName",
        "role": "role",
        "orderHistory": "orderHistory"
      },

      "clientSettable": {
        "id": false,
        "orderHistory": false
      },

      "validSeed": {
        "name": "John Doe",
        "address": "123 Main Street, City, Country",
        "phone": "+1234567890",
        "accountNumber": "123456789",
        "bankName": "Test Bank",
        "role": "CUSTOMER"
      },

      "endpoints": {
        "create": {
          "method": "POST",
          "path": "/customers",
          "async": false,
          "acceptedStatus": 201,
          "requestSchema": { "requiredFields": ["name", "address", "phone", "accountNumber", "bankName"] }
        },
        "getById": { "method": "GET", "path": "/customers/{id}", "async": false },
        "list": { "method": "GET", "path": "/customers", "async": false }
      }
    },

    "Product": {
      "basePath": "products",

      "responseEnvelope": { "style": "flat", "dataPath": "" },
      "listEnvelope": { "dataPath": "" },
      "errorResponseSchema": {
        "statusField": "detail",
        "messageField": "detail",
        "fieldErrorsPath": null
      },

      "fieldMap": {
        "id": "id",
        "description": "description",
        "price.amount": "price.amount",
        "price.currency": "price.currency"
      },

      "clientSettable": {
        "id": false
      },

      "validSeed": {
        "description": "Test Product Description",
        "price": {
          "amount": "19.99",
          "currency": "USD"
        }
      },

      "endpoints": {
        "create": {
          "method": "POST",
          "path": "/products",
          "async": false,
          "acceptedStatus": 201,
          "requestSchema": { "requiredFields": ["description", "price"] }
        },
        "getById": { "method": "GET", "path": "/products/{id}", "async": false },
        "list": { "method": "GET", "path": "/products", "async": false }
      }
    },

    "Order": {
      "basePath": "orders",

      "responseEnvelope": { "style": "flat", "dataPath": "" },
      "listEnvelope": { "dataPath": "" },
      "errorResponseSchema": {
        "statusField": "detail",
        "messageField": "detail",
        "fieldErrorsPath": null
      },

      "fieldMap": {
        "id": "id",
        "customerRef": "customerRef",
        "lineItems": "lineItems",
        "lineItems[].productRef": "lineItems[].productRef",
        "lineItems[].quantity": "lineItems[].quantity",
        "lineItems[].unitPriceSnapshot": "lineItems[].unitPriceSnapshot",
        "totalAmount": "totalAmount",
        "status": "status",
        "createdAt": "createdAt",
        "updatedAt": "updatedAt",
        "invoiceRef": "invoiceRef"
      },

      "clientSettable": {
        "id": false,
        "totalAmount": false,
        "lineItems[].unitPriceSnapshot": false,
        "createdAt": false,
        "updatedAt": false,
        "invoiceRef": false
      },
      "validSeed": {
        "customerRef": "{{customerId}}",
        "lineItems": [
          {
            "productRef": "{{productId}}",
            "quantity": 1
          }
        ]
      },

      "endpoints": {
        "create": {
          "method": "POST",
          "path": "/orders",
          "async": false,
          "acceptedStatus": 201,
          "requestSchema": { "requiredFields": ["customerRef", "lineItems"] }
        },
        "getById": { "method": "GET", "path": "/orders/{id}", "async": false },
        "list": { "method": "GET", "path": "/orders", "async": false },
        "review": {
          "method": "PUT",
          "path": "/orders/{id}/review",
          "async": false,
          "precondition": { "status": "PLACED" },
          "postcondition": { "status": "PLACED" },
          "requestSchema": { "requiredFields": [] }
        },
        "accept": {
          "method": "PUT",
          "path": "/orders/{id}/accept",
          "async": false,
          "precondition": { "status": "PLACED" },
          "postcondition": { "status": "ACCEPTED" },
          "requestSchema": { "requiredFields": [] }
        },
        "cancel": {
          "method": "PUT",
          "path": "/orders/{id}/cancel",
          "async": false,
          "precondition": { "status": "PLACED" },
          "postcondition": { "status": "CANCELLED" },
          "requestSchema": { "requiredFields": [] }
        },
        "verify": {
          "method": "PUT",
          "path": "/orders/{id}/verify",
          "async": false,
          "precondition": { "status": "PAID" },
          "postcondition": { "status": "VERIFIED" },
          "requestSchema": { "requiredFields": [] }
        },
        "ship": {
          "method": "PUT",
          "path": "/orders/{id}/ship",
          "async": false,
          "precondition": { "status": "VERIFIED" },
          "postcondition": { "status": "SHIPPED" },
          "requestSchema": { "requiredFields": [] }
        },
        "close": {
          "method": "PUT",
          "path": "/orders/{id}/close",
          "async": false,
          "precondition": { "status": "SHIPPED" },
          "postcondition": { "status": "CLOSED" },
          "requestSchema": { "requiredFields": [] }
        }
      }
    },

    "Invoice": {
      "basePath": "invoices",

      "responseEnvelope": { "style": "flat", "dataPath": "" },
      "listEnvelope": { "dataPath": "" },
      "errorResponseSchema": {
        "statusField": "detail",
        "messageField": "detail",
        "fieldErrorsPath": null
      },

      "fieldMap": {
        "id": "id",
        "orderRef": "orderRef",
        "billingInfo.name": "billingInfo.name",
        "billingInfo.address": "billingInfo.address",
        "totalAmount": "totalAmount",
        "issueDate": "issueDate",
        "dueDate": "dueDate",
        "status": "status"
      },

      "clientSettable": {
        "id": false,
        "billingInfo.name": false,
        "billingInfo.address": false,
        "totalAmount": false
      },

      "validSeed": {
        "orderRef": "{{orderId}}",
        "issueDate": "01/01/2025",
        "dueDate": "08/01/2025"
      },

      "endpoints": {
        "create": {
          "method": "POST",
          "path": "/invoices",
          "async": false,
          "acceptedStatus": 201,
          "requestSchema": { "requiredFields": ["orderRef"] }
        },
        "getById": { "method": "GET", "path": "/invoices/{id}", "async": false },
        "list": { "method": "GET", "path": "/invoices", "async": false },
        "cancel": {
          "method": "PUT",
          "path": "/invoices/{id}/cancel",
          "async": false,
          "precondition": { "status": "ISSUED" },
          "postcondition": { "status": "CANCELLED" },
          "requestSchema": { "requiredFields": [] }
        }
      }
    },

    "Payment": {
      "basePath": "payments",

      "responseEnvelope": { "style": "flat", "dataPath": "" },
      "listEnvelope": { "dataPath": "" },
      "errorResponseSchema": {
        "statusField": "detail",
        "messageField": "detail",
        "fieldErrorsPath": null
      },

      "fieldMap": {
        "id": "id",
        "orderRef": "orderRef",
        "amount": "amount",
        "timestamp": "timestamp",
        "status": "status",
        "method": "method"
      },

      "clientSettable": {
        "id": false,
        "timestamp": false,
        "status": false
      },

      "validSeed": {
        "orderRef": "{{orderId}}",
        "amount": "{{invoiceAmount}}",
        "method": "CREDIT_CARD"
      },

      "endpoints": {
        "create": {
          "method": "POST",
          "path": "/payments",
          "async": false,
          "acceptedStatus": 201,
          "requestSchema": { "requiredFields": ["orderRef", "amount", "method"] }
        },
        "getById": { "method": "GET", "path": "/payments/{id}", "async": false },
        "list": { "method": "GET", "path": "/payments", "async": false },
        "verify": {
          "method": "PUT",
          "path": "/payments/{id}/verify",
          "async": false,
          "precondition": { "status": "PENDING" },
          "postcondition": { "status": "VERIFIED" },
          "requestSchema": { "requiredFields": [] }
        },
        "reject": {
          "method": "PUT",
          "path": "/payments/{id}/reject",
          "async": false,
          "precondition": { "status": "PENDING" },
          "postcondition": { "status": "REJECTED" },
          "requestSchema": { "requiredFields": [] }
        }
      }
    }
  },

  "workflow": [
    { "step": 1, "entity": "Order", "action": "create", "actor": "Customer" },
    { "step": 2, "entity": "Order", "action": "review", "actor": "OrderStaff" },
    { "step": 3, "entity": "Order", "action": "accept", "actor": "OrderStaff" },
    { "step": 4, "entity": "Invoice", "action": "create", "actor": "Accountant", "requires": { "order.status": "ACCEPTED" } },
    { "step": 5, "entity": "Payment", "action": "create", "actor": "Customer", "requires": { "invoice.status": "ISSUED" } },
    { "step": 6, "entity": "Payment", "action": "verify", "actor": "Accountant" },
    { "step": 7, "entity": "Order", "action": "verify", "actor": "OrderStaff" },
    { "step": 8, "entity": "Order", "action": "ship", "actor": "OrderStaff" },
    { "step": 9, "entity": "Order", "action": "close", "actor": "OrderStaff" }
  ]
}
