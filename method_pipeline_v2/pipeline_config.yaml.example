# ─────────────────────────────────────────────
#  Empirical Study Pipeline – Configuration
# ─────────────────────────────────────────────

workdir: "."

# ── Generation ────────────────────────────────
agent:
  type: "chatdev"
  model: "gemma4:31b"                      
  api_key: "YOUR KEY"
  api_base: "https://ollama.com/v1"
  temperature: 0.2
  workflow: "agents/chatdev.yaml"             # ChatDev's coding workflow
  prompt_template: "prompts/simple.md"        # path to the generation prompt
  generated_dir: "generated"

# ── Validation ────────────────────────────────
validation:
  # Code path to validate when running `--phase val` standalone
  # (ignored when running `--phase all`, where the code path comes from
  # the generation phase's GenerationResult instead).
  code: "generated/code_workspace"

  # Stage 1 – Compilability
  docker:
    image: "python:3.11-slim"
    timeout_seconds: 60
    workdir: "/app"

  # Stage 2 – Functional tests (HTTP)
  http:
    base_url: "http://localhost:8000"
    timeout_seconds: 10

# ── Validator settings ─────────────────────────
# Read directly by the validator classes (validators/*.py).
validator:
  start_command_file: "start_command.txt"
  boot_wait_seconds: 15          # Stage 1 – how long to wait for the server to crash on boot
  smoke_path: "/"                # Stage 1 – path probed after boot to catch startup-time 5xx
  smoke_timeout: 10
  nfr_trace_filename: "nfr-trace.json"   # Stage 3 – NFR trace file name inside the code dir

  # Stage 2 – whether the prompt version used to generate this app requires
  # workflow_apis.json (see prompts/latest_dynamic.md's "Workflow Manifest"
  # section vs. prompts/latest.md, which never asked for it). When true and
  # the file is missing/empty, FunctionalValidator logs it as a generation
  # defect. When false, the same absence is logged as expected for this
  # prompt version - ACCEPTED/INVOICED-dependent test cases still fail, but
  # are not attributed to the app. See docs/workflow_dependency_test_cases.md
  # for exactly which test cases that affects.
  expect_workflow_manifest: true

# ── Output ────────────────────────────────────
output:
  report_dir: "reports/"
