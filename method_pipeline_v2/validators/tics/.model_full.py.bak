"""
model.py
────────
Language-neutral code graph. Nothing in this module knows about Python: it is
plain data plus a traversal, so the scoring engine and every future language
frontend share one representation.

Distance is measured on the UNDIRECTED graph. Two tactics rarely call each
other — they meet at a common caller, which is exactly the shape the source
document describes (`update_order` calling both `cache.invalidate` and
`transaction.commit`, counted as distance 2). Following call direction only
would score that pair as unreachable.
"""

from __future__ import annotations

import heapq
import math
from dataclasses import dataclass, field
from typing import Iterable, Iterator

# Edge kinds. CALLS, TXN_BOUNDARY and SHARED_STATE are emitted. The three
# co-participation kinds were each built, measured on the sample, and removed;
# the constants stay so a graph dumped before their removal still loads.
#
#   DATA/EVENT     never existed. Producers name events by string literal and
#                  consumers handle them generically, so nothing ever matched.
#   USES_CONFIG    built and measured: removing it changed no distance, on any
#                  pair, in any repository. Apps read configuration once in the
#                  composition root and inject it, so no two scored functions
#                  ever read the same key.
#   USES_RESOURCE  built, priced by how specific the shared entity was, and still
#                  removed. Across five repositories it moved exactly one, by
#                  +0.116 — enough to flip a ranking — and the cause was that
#                  that app happened to split its session types (PrimarySession
#                  k=5, ReplicaSession k=3) where others used one Session with
#                  k=20-46. Naming granularity, not architecture. Two functions
#                  that both open a database session are contending for a
#                  resource, not interacting through code, and CALLS already
#                  carries the interactions that exist.
CALLS = "CALLS"
SHARED_STATE = "SHARED_STATE"
USES_CONFIG = "USES_CONFIG"
USES_RESOURCE = "USES_RESOURCE"
TXN_BOUNDARY = "TXN_BOUNDARY"

# When two functions are linked for more than one reason, the path should report
# the most informative one. "these two operations share an atomic scope" says
# more about architectural tension than "one calls the other", and a call that
# happens inside a transaction is both.
KIND_PRECEDENCE = {TXN_BOUNDARY: 3, SHARED_STATE: 2, USES_CONFIG: 1, USES_RESOURCE: 1, CALLS: 0}

# Degree at which a shared callee stops being a participant and starts being
# plumbing. Median degree across the sample is 1-2 and the p90 is 4-32, so 4 sits
# just above ordinary connectivity. Only ever applied to shared callees — see
# _shared_callee_penalty for why degree alone is the wrong test.
HUB_DEGREE_BASE = 4


@dataclass(frozen=True)
class FunctionNode:
    """One function or method, addressed the same way nfr-trace.json addresses it."""

    ref: str                    # "app/workers/outbox.py::OutboxDispatcher.claim_batch"
    file: str                   # "app/workers/outbox.py"
    qualname: str               # "OutboxDispatcher.claim_batch"
    lineno: int = 0
    class_name: str | None = None


@dataclass(frozen=True)
class Edge:
    src: str
    dst: str
    kind: str
    detail: str = ""            # why this edge exists, e.g. the matched pattern
    # Hops are not equal. A direct call is one unit of interaction. A
    # co-participation link — both functions touch the same resource or config
    # key — is only as informative as that entity is specific: sharing a Redis
    # client with one other function says something, sharing an AsyncSession
    # with 45 others says nothing. Cost carries that, so distance stays a single
    # comparable quantity instead of needing a separate strength channel.
    cost: float = 1.0
    directed: bool = True       # False for symmetric co-participation links


@dataclass
class Path:
    """A shortest connection between two functions, kept for the report so a
    reviewer can audit why a pair scored what it scored."""

    distance: float
    refs: list[str] = field(default_factory=list)
    kinds: list[str] = field(default_factory=list)


class CodeGraph:
    def __init__(self) -> None:
        self._nodes: dict[str, FunctionNode] = {}
        self._edges: list[Edge] = []
        self._adjacency: dict[str, dict[str, tuple[str, float, int]]] = {}  # ref -> nb -> (kind, cost, dir)
        # Diagnostics. `external` (a call into stdlib or a third-party package) is
        # expected and harmless — those targets are outside the graph by design.
        # `unresolved` is the number that matters: first-party calls the frontend
        # could not type. Reporting them together would hide the second behind
        # the first, since library calls dominate any real codebase.
        self.external_calls: int = 0
        self.nodeless_calls: int = 0
        self.unresolved_calls: int = 0
        # A count alone cannot be audited: a missed edge changes a distance, and
        # a distance changes a score. These samples name the call expression and
        # where it sits, so a reviewer can judge whether the misses matter or are
        # all in code no conflicting tactic touches. Bounded — the count above
        # stays exact regardless.
        self.unresolved_samples: list[dict] = []

    # ── construction ────────────────────────────────────────────────────────
    def add_node(self, node: FunctionNode) -> None:
        self._nodes.setdefault(node.ref, node)
        self._adjacency.setdefault(node.ref, {})

    def add_edge(
        self, src: str, dst: str, kind: str, detail: str = "", cost: float = 1.0,
        directed: bool = True,
    ) -> None:
        """Record an edge. Self-loops are dropped: a function reaching itself is
        distance 0 by definition and a loop would only pad the adjacency."""
        if src == dst or src not in self._nodes or dst not in self._nodes:
            return
        self._edges.append(Edge(src, dst, kind, detail, cost, directed))
        # Undirected adjacency. Between two functions linked for several reasons,
        # keep the cheapest link — the strongest evidence — and break ties on the
        # more informative kind.
        rank = KIND_PRECEDENCE.get(kind, 0)
        # Direction is recorded from each endpoint's own point of view: +1 means
        # "I call the neighbour", -1 "the neighbour calls me". Co-participation
        # edges have no direction and get 0, which never triggers a penalty —
        # their cost already encodes how specific the shared entity is.
        for a, b, direction in ((src, dst, 1), (dst, src, -1)):
            existing = self._adjacency[a].get(b)
            if existing is None or (cost, -rank) < (existing[1], -KIND_PRECEDENCE.get(existing[0], 0)):
                self._adjacency[a][b] = (kind, cost, direction if directed else 0)

    # ── inspection ──────────────────────────────────────────────────────────
    def __contains__(self, ref: str) -> bool:
        return ref in self._nodes

    def __len__(self) -> int:
        return len(self._nodes)

    @property
    def nodes(self) -> Iterator[FunctionNode]:
        return iter(self._nodes.values())

    @property
    def edges(self) -> list[Edge]:
        return list(self._edges)

    def node(self, ref: str) -> FunctionNode | None:
        return self._nodes.get(ref)

    def neighbours(self, ref: str) -> Iterable[str]:
        return self._adjacency.get(ref, {}).keys()

    def edges_of_kind(self, kind: str) -> list[Edge]:
        return [e for e in self._edges if e.kind == kind]

    # ── traversal ───────────────────────────────────────────────────────────
    def distance(self, a: str, b: str, max_distance: float = 6) -> float | None:
        """Undirected shortest cost, 0 when a is b, None when unreachable or
        beyond `max_distance`. The cap matters: without it, a small repository
        becomes fully connected through common utilities and every pair scores
        nonzero. All-CALLS paths cost 1 per hop, so the value stays a plain hop
        count wherever no weighted edge is involved."""
        path = self.shortest_path(a, b, max_distance)
        return path.distance if path is not None else None

    def shortest_path(self, a: str, b: str, max_distance: float = 6) -> Path | None:
        """Dijkstra rather than BFS: edges carry different costs, so the fewest
        hops is not necessarily the strongest connection."""
        if a not in self._nodes or b not in self._nodes:
            return None
        if a == b:
            return Path(distance=0.0, refs=[a], kinds=[])

        # A node is visited in two states — reached as a callee, or as a caller —
        # because the penalty for passing through it depends on the direction we
        # arrived from. Both `best` and `previous` are therefore keyed by state,
        # not by node: keying `previous` by node alone lets the two states
        # overwrite each other and reconstructs paths that were never walked.
        start = (a, False)
        best: dict[tuple[str, bool], float] = {start: 0.0}
        previous: dict[tuple[str, bool], tuple[str, bool]] = {}
        queue: list[tuple[float, str, bool]] = [(0.0, a, False)]
        while queue:
            cost, current, as_callee = heapq.heappop(queue)
            state = (current, as_callee)
            if cost > best.get(state, math.inf):
                continue
            if current == b:
                return self._rebuild(previous, start, state, cost)
            for neighbour, (_, edge_cost, direction) in self._adjacency.get(current, {}).items():
                penalty = (
                    0.0 if current == a
                    else self._shared_callee_penalty(current, as_callee, direction)
                )
                candidate = cost + edge_cost + penalty
                nxt = (neighbour, direction > 0)      # True: current calls neighbour
                if candidate > max_distance or candidate >= best.get(nxt, math.inf):
                    continue
                best[nxt] = candidate
                previous[nxt] = state
                heapq.heappush(queue, (candidate, neighbour, nxt[1]))
        return None

    def _shared_callee_penalty(self, ref: str, arrived_as_callee: bool, out: int) -> float:
        """Cost of passing through a node that both endpoints merely call.

        Direction is what separates evidence from coincidence:

            u -> v -> w   v orchestrates both. This is the interaction the whole
                          metric exists to find, and v is necessarily high-degree
                          BECAUSE it does a lot inside one scope. Free.

            u -> v <- w   v is a utility u and w happen to share — an exception
                          constructor, a session helper. Two service methods are
                          not interacting because both raise NotFoundError. Charged.

        Penalising by degree alone was tried first and was wrong in exactly the
        way that matters: it charged the orchestrator, which drove the strongest
        cache-versus-transaction witness in the sample from 0.50 down to 0.21.

        The magnitude counts CALLERS, not total degree. Those differ sharply and
        in the direction that matters: `InvoiceService.create` has in-degree 1 and
        total degree 19 — an orchestrator, not a utility — while
        `transaction_session` has in-degree 11 of a total 34. Sizing the penalty
        by total degree would recreate the same mistake inside the rule meant to
        avoid it. A callee shared by two or three functions still costs nothing:
        that is a genuine relationship, and only ambient plumbing is charged.
        """
        if not (arrived_as_callee and out < 0):
            return 0.0
        callers = sum(1 for _, _, d in self._adjacency.get(ref, {}).values() if d < 0)
        return (
            max(0.0, math.log2(callers / HUB_DEGREE_BASE))
            if callers > HUB_DEGREE_BASE
            else 0.0
        )

    def _rebuild(
        self,
        previous: dict[tuple[str, bool], tuple[str, bool]],
        start: tuple[str, bool],
        end: tuple[str, bool],
        cost: float,
    ) -> Path:
        states = [end]
        while states[-1] != start:
            states.append(previous[states[-1]])
        states.reverse()
        refs = [ref for ref, _ in states]
        kinds = [self._adjacency[refs[i]][refs[i + 1]][0] for i in range(len(refs) - 1)]
        return Path(distance=round(cost, 4), refs=refs, kinds=kinds)

    # ── serialisation ───────────────────────────────────────────────────────
    def to_dict(self) -> dict:
        return {
            "nodes": [
                {
                    "ref": n.ref,
                    "file": n.file,
                    "qualname": n.qualname,
                    "lineno": n.lineno,
                    "className": n.class_name,
                }
                for n in self._nodes.values()
            ],
            "edges": [
                {"src": e.src, "dst": e.dst, "kind": e.kind, "detail": e.detail,
                 "cost": round(e.cost, 4), "directed": e.directed}
                for e in self._edges
            ],
            "diagnostics": {
                "externalCalls": self.external_calls,
                "nodelessCalls": self.nodeless_calls,
                "unresolvedCalls": self.unresolved_calls,
                "unresolvedSamples": self.unresolved_samples,
            },
        }

    @classmethod
    def from_dict(cls, payload: dict) -> CodeGraph:
        graph = cls()
        for n in payload["nodes"]:
            graph.add_node(
                FunctionNode(
                    ref=n["ref"],
                    file=n["file"],
                    qualname=n["qualname"],
                    lineno=n.get("lineno", 0),
                    class_name=n.get("className"),
                )
            )
        for e in payload["edges"]:
            graph.add_edge(e["src"], e["dst"], e["kind"], e.get("detail", ""),
                           e.get("cost", 1.0), e.get("directed", True))
        diagnostics = payload.get("diagnostics", {})
        graph.external_calls = diagnostics.get("externalCalls", 0)
        graph.nodeless_calls = diagnostics.get("nodelessCalls", 0)
        graph.unresolved_calls = diagnostics.get("unresolvedCalls", 0)
        graph.unresolved_samples = diagnostics.get("unresolvedSamples", [])
        return graph
